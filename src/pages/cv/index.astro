---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { existsSync } from 'node:fs';
const cvAvailable = existsSync(new URL('../../../public/cv.pdf', import.meta.url));
---
<BaseLayout title="CV — Dāniels Dūda">
  <header class="page-heading"><p class="eyebrow">Background & experience</p><h1>CV<span class="accent">.</span></h1><p class="lead">Technology, coordination, and learning.</p></header>
  {cvAvailable ? <section aria-label="Curriculum vitae">
    <div class="cv-actions"><a class="text-link" href="/cv.pdf" target="_blank" rel="noopener noreferrer">Open PDF <span class="sr-only">(opens in a new tab)</span> ↗</a><a class="cv-download" href="/cv.pdf" download="Daniels-Duda-CV.pdf">Download CV</a></div>
    <object class="cv-viewer" data="/cv.pdf" type="application/pdf" aria-label="Dāniels Dūda’s CV"><p>Your browser cannot display this PDF. <a href="/cv.pdf">Open the CV</a> or use the download button above.</p></object>
  </section> : <div class="empty-state"><span class="eyebrow">Coming soon</span><h2>My CV will be available here.</h2><p>You’ll be able to read it on this page or download a PDF copy.</p></div>}
</BaseLayout>
