---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { projects } from '../data/projects';
---
<BaseLayout>
  <header class="page-heading"><p class="eyebrow">Technology · People · Curiosity</p><h1>Hi, I’m Dāniels<span class="accent">.</span></h1><p class="lead">Connecting ideas, people, and technology.</p></header>
  <div class="prose intro-copy"><p>My work spans software development, IT project coordination, and teaching. This is where I share what I build, explore, and learn along the way.</p><p>I enjoy the space where technical work meets people. Beyond that, I’m interested in AI tools and creative activities: opportunities to experiment, see things differently, and turn curiosity into something useful.</p></div>
  <ul class="interests" aria-label="Areas of interest"><li>Software</li><li>IT coordination</li><li>Teaching</li><li>AI tools</li><li>Creative work</li></ul>
  <section class="section" aria-labelledby="featured-title"><div class="section-title-row"><h2 id="featured-title">Selected work</h2><a class="text-link" href="/projects/">All projects <SocialIcon name="arrow" /></a></div><p class="section-intro">A mix of learning projects, practical tools, and experiments with software and AI.</p><div class="project-grid">{projects.slice(0, 2).map(project => <ProjectCard {...project} />)}</div></section>

</BaseLayout>
