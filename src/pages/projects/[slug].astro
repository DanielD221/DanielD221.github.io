---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SocialIcon from '../../components/SocialIcon.astro';
import { projects } from '../../data/projects';
export function getStaticPaths() {
  return projects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
---
<BaseLayout title={`${project.title} — Dāniels Dūda`} description={project.description}>
  <a class="text-link back-link" href="/projects/">← All projects</a>
  <header class="page-heading"><p class="eyebrow">{project.category}</p><h1>{project.title}<span class="accent">.</span></h1><p class="lead">{project.description}</p></header>
  <div class="project-meta"><span class="badge">{project.status}</span><a class="text-link" href={`https://github.com/DanielD221/${project.repository}`} target="_blank" rel="noopener noreferrer"><SocialIcon name="github" />View source on GitHub<span class="sr-only"> (opens in a new tab)</span></a></div>
  <ul class="interests" aria-label="Technologies">{project.stack.map(technology => <li>{technology}</li>)}</ul>
  <section class="section prose" aria-labelledby="overview"><h2 id="overview">About the project</h2><p>{project.overview}</p></section>
  <section class="section prose" aria-labelledby="features"><h2 id="features">What’s inside</h2><ul>{project.features.map(feature => <li>{feature}</li>)}</ul></section>
  <section class="section prose" aria-labelledby="status"><h2 id="status">Current stage</h2><p>{project.note}</p><p>Setup instructions and more technical details are in the <a href={`https://github.com/DanielD221/${project.repository}#readme`} target="_blank" rel="noopener noreferrer">repository README<span class="sr-only"> (opens in a new tab)</span></a>.</p></section>
</BaseLayout>
