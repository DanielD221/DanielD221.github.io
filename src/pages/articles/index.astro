---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout noindex title="Articles — Dāniels Dūda"><header class="page-heading"><p class="eyebrow">Notes & ideas</p><h1>Articles<span class="accent">.</span></h1><p class="lead">What I’m learning along the way.</p></header>{articles.length ? <div class="article-list">{articles.map(article => <article><time datetime={article.data.publishedAt.toISOString()}>{article.data.publishedAt.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time><h2><a href={`/articles/${article.id}/`}>{article.data.title}</a></h2><p>{article.data.description}</p></article>)}</div> : <div class="empty-state"><span class="eyebrow">Coming soon</span><h2>The first page is still ahead.</h2><p>I’ll share notes on software, teaching, AI tools, and creative experiments here.</p></div>}</BaseLayout>
